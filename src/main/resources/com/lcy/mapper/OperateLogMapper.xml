<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lcy.mapper.OperateLogMapper">

    <select id="list" resultType="com.lcy.pojo.OperateLog">
        select * from operate_log
        <where>
            <if test="operateEmpId != null">
                and operate_emp_id = #{operateEmpId}
            </if>
            <if test="begin != null and end != null">
                and operate_time between #{begin} and #{end}
            </if>
        </where>
        order by operate_time
    </select>

</mapper>
